VITE_API_BASE_URL=http://localhost:3000
VITE_ADMIN_PANEL_TOKEN=

# Em desenvolvimento (`.env.development`), VITE_USE_MOCK_DATA=true mostra dados fictícios.
# Para testar contra o bot local: crie `.env.local` com VITE_USE_MOCK_DATA=false
# VITE_USE_MOCK_DATA=true

# Login Microsoft (Entra ID). Se VITE_AZURE_CLIENT_ID estiver vazio, o painel abre sem ecrã de login (dev).
# App registration: tipo SPA; redirect URI = URL deste site (ex. http://localhost:5173/)
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# Opcional; por defeito usa window.location.origin + "/"
# VITE_AZURE_REDIRECT_URI=http://localhost:5173/
